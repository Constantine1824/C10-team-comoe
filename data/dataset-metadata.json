{
  "title": "Medical Advice SLM Benchmark",
  "id": "YOUR_KAGGLE_USERNAME/medical-advice-slm",
  "subtitle": "Fine-tune a small LM for evidence-based health Q&A with safety guardrails",
  "description": "24-document synthetic public-health corpus with train QA pairs. Submit short answers for test questions. Scored by mean Levenshtein distance (lower is better). Educational only — not medical advice.",
  "licenses": [{ "name": "CC-BY-4.0" }],
  "keywords": ["medical-nlp", "slm", "fine-tuning", "healthcare", "patient-education", "safety"],
  "resources": [
    {
      "path": "documents.csv",
      "description": "24 public-health factsheets for fine-tuning.",
      "schema": {
        "fields": [
          { "name": "document_id", "type": "string" },
          { "name": "title", "type": "string" },
          { "name": "text", "type": "string" },
          { "name": "topic", "type": "string" },
          { "name": "care_setting", "type": "string" },
          { "name": "population", "type": "string" },
          { "name": "origin", "type": "string" },
          { "name": "source_url", "type": "string" },
          { "name": "license", "type": "string" }
        ]
      }
    },
    {
      "path": "train_qa.csv",
      "description": "43 training question-answer pairs.",
      "schema": {
        "fields": [
          { "name": "QuestionId", "type": "integer" },
          { "name": "question", "type": "string" },
          { "name": "topic", "type": "string" },
          { "name": "care_setting", "type": "string" },
          { "name": "population", "type": "string" },
          { "name": "document_id", "type": "string" },
          { "name": "reference_answer", "type": "string" }
        ]
      }
    },
    {
      "path": "test_questions.csv",
      "description": "11 test questions without answers.",
      "schema": {
        "fields": [
          { "name": "QuestionId", "type": "integer" },
          { "name": "question", "type": "string" },
          { "name": "topic", "type": "string" },
          { "name": "care_setting", "type": "string" },
          { "name": "population", "type": "string" }
        ]
      }
    },
    {
      "path": "sample_submission.csv",
      "schema": {
        "fields": [
          { "name": "QuestionId", "type": "integer" },
          { "name": "Answer", "type": "string" }
        ]
      }
    },
    { "path": "baseline_submission.csv", "description": "Topic-filtered retrieval baseline." },
    { "path": "DATACARD.md", "description": "Full documentation." }
  ]
}
